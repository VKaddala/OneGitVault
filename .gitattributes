# ============================================================
#  OneGitVault — .gitattributes
#  Normalise line endings so the repo works cross-platform.
# ============================================================

# Default: auto-detect text files and normalise to LF in repo
*          text=auto eol=lf

# Windows-specific scripts must keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files — no line-ending conversion
*.ico      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.otf      binary
*.exe      binary
*.dll      binary
*.zip      binary
*.7z       binary
*.tar      binary
*.gz       binary
*.pfx      binary
*.p12      binary
*.cer      binary
