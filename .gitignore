# ============================================================
#  OneGitVault — .gitignore
#  Only source files & config are committed. Everything that
#  is generated, downloaded, or machine-specific is excluded.
# ============================================================

# ───────────────────────────────────────────
# Node / npm
# ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json        # commit only if you want reproducible installs
                         # remove this line if you DO want to commit it

# ───────────────────────────────────────────
# Build output — Vite (web)
# ───────────────────────────────────────────
dist/
dist-ssr/

# ───────────────────────────────────────────
# Build output — Electron packager / builder
# ───────────────────────────────────────────
release/
out/
win-unpacked/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.nsis
*.blockmap

# ───────────────────────────────────────────
# Electron cache & temp
# ───────────────────────────────────────────
.electron/
electron-builder-cache/

# ───────────────────────────────────────────
# TypeScript compiled output
# ───────────────────────────────────────────
*.tsbuildinfo
*.js.map

# ───────────────────────────────────────────
# Vite cache
# ───────────────────────────────────────────
.vite/
*.local

# ───────────────────────────────────────────
# Environment / secrets
# ───────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example template

# ───────────────────────────────────────────
# Code-signing artefacts (keep out of repo)
# ───────────────────────────────────────────
*.pfx
*.p12
*.cer
*.key
*.pem

# ───────────────────────────────────────────
# OS-generated junk
# ───────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ───────────────────────────────────────────
# Editor / IDE
# ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ───────────────────────────────────────────
# Logs & diagnostics
# ───────────────────────────────────────────
logs/
*.log

# ───────────────────────────────────────────
# Android App (Sources tracked, builds ignored)
# ───────────────────────────────────────────
android/node_modules/
android/dist/
android/dist-ssr/
android/*.apk
android/*.aab
*.apk
*.aab
android/android/.gradle/
android/android/build/
android/android/app/build/
android/android/*/build/
android/android/local.properties
android/android/.idea/
android/android/*.iml
android/android/*/*.iml
android/android/capacitor-cordova-android-plugins/
android/android/app/src/main/assets/public/
android/android/app/src/main/assets/capacitor.config.json
android/android/app/src/main/assets/capacitor.plugins.json

# ───────────────────────────────────────────
# Optional: keep package-lock.json
# (remove the ignore above and uncomment below
#  if you want reproducible CI installs)
# ───────────────────────────────────────────
# !package-lock.json
