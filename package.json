{
  "name": "onegitvault",
  "productName": "OneGitVault",
  "version": "1.0.0",
  "description": "Unified Open-Source Observatory",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "desktop": "node scripts/start-electron.cjs",
    "desktop:build": "npm run build && electron .",
    "build": "tsc && vite build",
    "package": "npm run build && electron-packager . OneGitVault --platform=win32 --arch=x64 --out=release --overwrite --prune=true",
    "dist": "npm run package",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
