{
  "name": "onegitvault",
  "productName": "OneGitVault",
  "version": "2.3.0",
  "author": "VKaddala",
  "publisher": "VKaddala",
  "description": "High-speed GitHub Observatory & Client for Windows & Android. Discover, stream, inspect READMEs & releases, explore trending repositories, and sync bookmarked vaults with GitHub Gists.",
  "homepage": "https://github.com/VKaddala/OneGitVault/releases/latest",
  "keywords": [
    "github-client",
    "github-explorer",
    "github-trending",
    "github-dashboard",
    "trending-repositories",
    "developer-tools",
    "open-source",
    "desktop-app",
    "android-app",
    "electron",
    "capacitor",
    "react",
    "typescript",
    "bookmarks",
    "gist-sync",
    "local-first",
    "vault",
    "github-api",
    "apk",
    "windows"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc && vite build",
    "start": "node scripts/start-electron.cjs",
    "desktop": "node scripts/start-electron.cjs",
    "installer": "npm run build && electron-builder --win --x64",
    "installer:dir": "npm run build && electron-builder --win --dir --x64",
    "bump": "node scripts/bump-version.cjs",
    "publish-release": "node scripts/publish-release.cjs",
    "package": "npm run build && electron-packager . OneGitVault --platform=win32 --arch=x64 --icon=assets/icons/onegitvault.ico --out=release --overwrite --prune=true --ignore=android",
    "release": "cmd /c build-installer.bat"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.16.0",
    "marked": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.vkaddala.onegitvault",
    "productName": "OneGitVault",
    "publisherName": [
      "VKaddala"
    ],
    "copyright": "Copyright © 2026 VKaddala",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneGitVault",
      "uninstallDisplayName": "OneGitVault",
      "installerHeaderIcon": "",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
